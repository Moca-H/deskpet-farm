{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deskpet-farm",
  "version": "0.1.0",
  "identifier": "com.mocah.deskpetfarm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "deskpet",
        "url": "/pet",
        "width": 200,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "farm",
        "title": "deskpet farm",
        "url": "/farm",
        "width": 960,
        "height": 640,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
