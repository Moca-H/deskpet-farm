{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for pet and farm windows",
  "windows": ["pet", "farm"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events",
    "opener:default",
    "dialog:default",
    "allow-game"
  ]
}
